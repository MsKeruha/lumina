# Database Configuration (for Postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lumina

# Application Connection (for Backend and Migrations)
DB_USER=postgres
DB_PASSWORD=postgres
